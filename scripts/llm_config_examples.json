        "api_key": "sk-...sua-api-key-aqui...",
        "base_url": "https://api.openai.com/v1",
        "temperature": 0.7,
        "max_tokens": 1000,
        "context_window": 4096,
        "rag_enabled": true,
        "default_rag_collection": "neoquima"
      },
      "requirements": "API Key da OpenAI",
      "costs": "Por token usado",
      "best_for": "Produção, alta qualidade, estabilidade"
