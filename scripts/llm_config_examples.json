    "google": {
      "name": "Google (Gemini)",
      "description": "Provider do Google com modelos Gemini",
      "config": {
        "provider": "google",
        "model": "gemini-1.5-flash",
        "api_key": "AIza...sua-api-key-aqui...",
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "temperature": 0.7,
        "max_tokens": 1000,
        "context_window": 4096,
