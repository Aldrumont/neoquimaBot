  "testing": {
    "test_providers": {
      "description": "Testar funcionamento dos providers",
      "command": "python scripts/test_llm_providers.py"
    },
    
    "test_chat": {
      "description": "Testar endpoint de chat",
      "command": "curl -X POST http://localhost:8003/api/chat -H 'Content-Type: application/json' -d '{\"message\":\"Teste\",\"user_id\":\"test\"}'"
    },
    
    "health_check": {
      "description": "Verificar saúde do serviço",
      "command": "curl http://localhost:8003/health"
    }
  },
  
