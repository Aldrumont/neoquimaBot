{
  "providers": {
    "ollama": {
      "name": "Ollama (Local)",
      "description": "Provider local sem custos, sem limites de API",
      "config": {
        "provider": "ollama",
        "model": "llama2:3b",
        "base_url": "http://ollama:11434",
        "temperature": 0.7,
        "max_tokens": 1000,
        "context_window": 4096,
        "rag_enabled": true,
        "default_rag_collection": "neoquima"
      },
      "requirements": "Docker com Ollama rodando",
      "costs": "Gratuito",
      "best_for": "Desenvolvimento, testes, uso local"
    },
    
    "openai": {
      "name": "OpenAI",
      "description": "Provider da OpenAI com modelos GPT de alta qualidade",
