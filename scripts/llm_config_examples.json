        "temperature": 0.7,
        "max_tokens": 1000,
        "context_window": 4096,
        "rag_enabled": true,
        "default_rag_collection": "neoquima"
      },
      "requirements": "API Key do Azure + URL do deployment",
      "costs": "Por token usado (via Azure)",
      "best_for": "Empresas, compliance, Azure"
