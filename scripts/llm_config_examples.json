        "temperature": 0.7,
        "max_tokens": 1000,
        "context_window": 4096,
        "rag_enabled": true,
        "default_rag_collection": "neoquima"
      },
      "requirements": "API Key da Anthropic",
      "costs": "Por token usado",
      "best_for": "Conversas naturais, ética, qualidade"
